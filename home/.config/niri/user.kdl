// DMS 既定 (dms/*.kdl) への上書き。config.kdl が最後に include する。
// niri に unbind は無く、後から同じキーを宣言したものが勝つ (include をまたいだときだけ。
// 1 つのファイルに同じセクションを 2 回書くとパースエラーになる)。
//
// === Mod = Alt (物理 Option) にしている ===
// xremap (modules/nixos/xremap.nix) が macOS の Cmd 再現のために Super+C/V/X/A/Z/S/W/T/F/R/
// L/K/N/P/O/Q/Return を Ctrl+同キーに変えてしまうので、Mod=Super のままだと DMS 既定と niri
// 公式のバインドが半分も届かなかった (fullscreen-window や toggle-window-floating は押す手段が
// 無かった)。Mod を Alt に移すと Super を丸ごと Cmd 再現に返せて、DMS 既定と公式配列が
// そのまま Option 側で使える。ネットのチートシートも「Mod = Option」と読むだけで通る。
//
// 代償は Option+文字 をターミナルから奪うこと。zsh の Meta バインド (Alt+. の last-arg、
// fzf の Alt+C など) と衝突する。Mod+Escape (= Option+Esc) の shortcut-inhibit トグルで
// 一時的に niri 側を黙らせられる。
//
// Hyprland 側 (hypr/dms/binds-user.lua) から持ってきていないもの:
// - Magnet 風の四分割: 全ウィンドウ浮動の Hyprland 用。スクロール式のタイリングを試すのが
//   niri の目的なので持ち込まない。Magnet の矢印 (xremap が Ctrl+Option+矢印 → Super+矢印に
//   変える) だけ下で拾う。U/I/J/K は DMS 既定のまま。
// - DMS のランチャー上での Emacs バインド (Ctrl+N/P/M など): Hyprland では layer が開いて
//   いる間だけバインドを足して補っていた。niri には layer の開閉を拾う仕組みが無い。
// - HHKB だけナチュラルスクロールを切る指定: niri の input はデバイス単位の上書きを持たない。
//   ただし今つないでいる機器では mouse クラスが HHKB のスティックだけなので、下の mouse 節で足りる。

binds {
    // === DMS 既定で埋まらないところ ===
    // DMS は powermenu だけ Mod ではなく素の Super+X に置いていて、そこは xremap が食う
    Mod+X hotkey-overlay-title="Power menu" { spawn "dms" "ipc" "call" "powermenu" "toggle"; }
    // Mission Control 相当。Super+Tab は Cmd+Tab の MRU 切り替え (config.kdl) に使っている
    Mod+Tab repeat=false { toggle-overview; }
    // DMS のロックは Mod+Alt+L 表記で、Mod=Alt だと Alt+L に潰れて DMS 自身の
    // Mod+L (focus-column-right) と同じキーになる。物理 Cmd+Option+L のまま残す
    // (xremap は Super+Alt+L を素通しする)。
    Super+Alt+L hotkey-overlay-title="Lock screen" { spawn "dms" "ipc" "call" "lock" "lock"; }

    // === 矢印はモニタ境界を越える版に差し替える ===
    // ディスプレイ 2 枚を 1 本のスクロール帯のように扱いたいので、境界で止まる
    // focus-column-left / move-column-left ではなく or-monitor 版を当てる。
    // niri には「あふれたら自動で隣のモニタへ」という仕組みは無い (出力ごとにワークスペースが
    // 独立している。upstream でも not planned) ので、手で押し出す形でしか帯をまたげない。
    Mod+Left  { focus-column-or-monitor-left; }
    Mod+Right { focus-column-or-monitor-right; }
    Mod+Up    { focus-window-or-monitor-up; }
    Mod+Down  { focus-window-or-monitor-down; }
    Mod+Shift+Left  { move-column-left-or-to-monitor-left; }
    Mod+Shift+Right { move-column-right-or-to-monitor-right; }

    // === Magnet の筋肉記憶 (Ctrl+Option+矢印) ===
    // xremap が Super+矢印 に変えて寄こす。Mod ではなくなったので Super と明示する。
    // 素の Cmd+矢印 も同じキーになる。
    // 最大化に fullscreen-window ではなく maximize-window-to-edges を当てるのは、Magnet の
    // 最大化が macOS のメニューバーを残すのと同じで DMS のバーを残したいから。トグルなので
    // Magnet の「元に戻す」(Ctrl+Option+↓) に別の action は要らない。
    Super+Up    { maximize-window-to-edges; }
    Super+Left  { move-column-left-or-to-monitor-left; }
    Super+Right { move-column-right-or-to-monitor-right; }
    Super+Down  { move-window-down; }

    // === キーボードバックライト (MacBook の F5/F6) ===
    // DMS の brightness IPC は画面用なので brightnessctl で leds クラスを直接動かす
    // (modules/nixos/desktop/dms.nix)。デバイス名は機種で変わるので glob。niri の spawn は
    // shell を通さないが、パターンは brightnessctl 自身が解決する。
    XF86KbdBrightnessUp allow-when-locked=true repeat=true {
        spawn "brightnessctl" "-d" "*::kbd_backlight" "set" "10%+";
    }
    XF86KbdBrightnessDown allow-when-locked=true repeat=true {
        spawn "brightnessctl" "-d" "*::kbd_backlight" "set" "10%-";
    }
}

// === 入力: macOS の既定 + modules/darwin/default.nix の上書きに合わせる ===
// 揃えているものは hypr/dms/binds-user.lua の同じ節と同じ。DMS の dms/input.kdl は
// タップ・ナチュラルスクロール・加速だけを書くので、それ以外はここで足す。
input {
    // 上の「Mod = Alt」参照。niri 25.05 以降の設定。
    mod-key "Alt"
    keyboard {
        // キーリピートは macOS の最速 (66/s, 225ms) より速い。macOS 側は KeyRepeat = 1 が
        // 下限でこれ以上詰められないので、ここだけ揃わない。
        repeat-delay 180
        repeat-rate 80
    }
    touchpad {
        tap
        natural-scroll
        dwt
        // 二本指クリックで右クリック (macOS と同じ)
        click-method "clickfinger"
        // スクロール量。トラックパッドは速く感じるので下げる
        scroll-factor 0.3
    }
    mouse {
        // ここに来るのは HHKB Studio のスティックだけ (04fe:0016 は ID_INPUT_MOUSE を出し、
        // ID_INPUT_POINTINGSTICK は出さないので niri の trackpoint 節には落ちない)。
        // スティックはトラックパッドと逆向き (natural-scroll なし) の方が押しやすい。
        scroll-factor 0.6
        // libinput の加速 (-1 〜 1)
        accel-speed 0.5
    }
}

cursor {
    hide-when-typing
}

// === 出力 (phoenix の 4K 2 枚) ===
// niri は output 設定が無いと物理サイズから小数スケールを自動で決める (この 2 枚では
// 1.5 と 1.25 になっていた)。等倍で使いたいので明示する。DMS の display 設定は
// dms/outputs.kdl に書くが、あれは gitignore された実行時ファイルなのでここで持つ。
// 名前は `niri msg outputs` の見出し。他ホストでは一致せず無視されるだけ。
// 位置は書かない (niri の自動配置に任せる)。
output "Dell Inc. DELL U2718QM KWHF293E0JRL" {
    scale 1
}
output "LG Electronics LG ULTRAFINE 501NTGY30383" {
    scale 1
}

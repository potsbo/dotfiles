// DMS 既定 (dms/*.kdl) への上書き。config.kdl が最後に include する。
// niri に unbind は無く、後から同じキーを宣言したものが勝つ (include をまたいだときだけ。
// 1 つのファイルに同じセクションを 2 回書くとパースエラーになる)。
//
// 何をどのキーに置くかは docs/keymap.md が決める。ここはそれを niri で満たすための
// 設定で、仕様が定めていないものは DMS の既定に任せる。ここに書くのは 3 種類だけ:
//   - 仕様にあるが DMS の既定では埋まらないもの (格子配置、画面をまたぐ移動、Mission Control)
//   - この機種にしか無いもの (キーボードバックライト)
//   - macOS の入力設定に揃えるための入力まわりと、出力のスケール
//
// Mod は既定のまま Super (物理 Cmd)。2026-09-13 に Mod=Alt を試したが、Option 面は
// アプリに渡すと決めたので戻した (docs/keymap.md §2)。その結果 DMS 既定の Mod+<英字> は
// 17 個が xremap に食われて niri に届かない。届かないままにしてあるのは、それらが仕様の
// 約束していない組み合わせだから。要るものだけ下で拾う。

binds {
    // === 格子配置 (docs/keymap.md §3.4 の P1〜P7) ===
    // 物理キーは Magnet と同じ Ctrl+Option。xremap は Ctrl+Alt+... を変換せずここへ渡す。
    // niri は 1 バインド 1 action しか書けないので、複数の action を niri-place にまとめて
    // ある (modules/nixos/desktop/niri-place.sh)。
    Ctrl+Alt+Left  hotkey-overlay-title="Left half"  { spawn "niri-place" "left"; }
    Ctrl+Alt+Right hotkey-overlay-title="Right half" { spawn "niri-place" "right"; }
    Ctrl+Alt+U     hotkey-overlay-title="Top-left quarter"     { spawn "niri-place" "tl"; }
    Ctrl+Alt+I     hotkey-overlay-title="Top-right quarter"    { spawn "niri-place" "tr"; }
    Ctrl+Alt+J     hotkey-overlay-title="Bottom-left quarter"  { spawn "niri-place" "bl"; }
    Ctrl+Alt+K     hotkey-overlay-title="Bottom-right quarter" { spawn "niri-place" "br"; }
    // P7 は 1 action で足りるのでスクリプトを通さない。fullscreen-window ではなく
    // maximize-window-to-edges なのは、Magnet の最大化が macOS のメニューバーを残すのと
    // 同じで DMS のバーを残したいから。
    Ctrl+Alt+Return hotkey-overlay-title="Maximize" { maximize-window-to-edges; }
    // MacBook 内蔵キーボード向けの別名 (docs/keymap.md §1.2)。Magnet も上矢印を最大化に
    // 当てている。
    Ctrl+Alt+Up { maximize-window-to-edges; }

    // === 画面をまたぐ移動 (docs/keymap.md §3.5 の P8/P9) ===
    // 物理キーは Magnet と同じ Ctrl+Option+Cmd。xremap に Ctrl+Alt+Super+矢印 を拾う規則は
    // 無いので、変換されずそのまま届く。
    // 列ごとではなく窓だけを送る (move-column-to-monitor-* ではない)。仕様が「窓を」と
    // 書いていて、Magnet も操作した窓だけが移るため。
    Ctrl+Alt+Mod+Left  hotkey-overlay-title="Move to left display"  { move-window-to-monitor-left; }
    Ctrl+Alt+Mod+Right hotkey-overlay-title="Move to right display" { move-window-to-monitor-right; }

    // === Mission Control (docs/keymap.md の W3) ===
    // Super+Tab と Alt+Tab は config.kdl の recent-windows が使っている。
    Mod+Alt+Tab repeat=false hotkey-overlay-title="Mission Control" { toggle-overview; }

    // === キーボードバックライト (MacBook の F5/F6) ===
    // DMS の brightness IPC は画面用なので brightnessctl で leds クラスを直接動かす
    // (modules/nixos/desktop/dms.nix)。デバイス名は機種で変わるので glob。niri の spawn は
    // shell を通さないが、パターンは brightnessctl 自身が解決する。
    XF86KbdBrightnessUp allow-when-locked=true repeat=true {
        spawn "brightnessctl" "-d" "*::kbd_backlight" "set" "10%+";
    }
    XF86KbdBrightnessDown allow-when-locked=true repeat=true {
        spawn "brightnessctl" "-d" "*::kbd_backlight" "set" "10%-";
    }
}

// === 入力: macOS の既定 + modules/darwin/default.nix の上書きに合わせる ===
// 揃えているものは hypr/dms/binds-user.lua の同じ節と同じ。DMS の dms/input.kdl は
// タップ・ナチュラルスクロール・加速だけを書くので、それ以外はここで足す。
input {
    keyboard {
        // キーリピートは macOS の最速 (66/s, 225ms) より速い。macOS 側は KeyRepeat = 1 が
        // 下限でこれ以上詰められないので、ここだけ揃わない。
        repeat-delay 180
        repeat-rate 80
    }
    touchpad {
        tap
        natural-scroll
        dwt
        // 二本指クリックで右クリック (macOS と同じ)
        click-method "clickfinger"
        // スクロール量。トラックパッドは速く感じるので下げる
        scroll-factor 0.3
    }
    mouse {
        // ここに来るのは HHKB Studio のスティックだけ (04fe:0016 は ID_INPUT_MOUSE を出し、
        // ID_INPUT_POINTINGSTICK は出さないので niri の trackpoint 節には落ちない)。
        // スティックはトラックパッドと逆向き (natural-scroll なし) の方が押しやすい。
        scroll-factor 0.6
        // libinput の加速 (-1 〜 1)
        accel-speed 0.5
    }
}

cursor {
    // テーマとサイズをここに書く理由: niri は XCURSOR_THEME / XCURSOR_SIZE を
    // 読む側ではなく、このノードの値を env として子プロセスに配る側。値は
    // home-manager (modules/nixos/desktop.nix の home.pointerCursor) が持つ
    // XCURSOR_* と同じだが、あちらは hm-session-vars.sh 経由でシェルにしか
    // 届かず、GDM から起動する niri 自身には入らない。書かないと niri の既定値
    // (テーマ "default"、サイズ 24) のままになる。片方だけ変えると、ランチャーから
    // 起動したアプリと端末から起動したアプリでカーソルの大きさがずれる。
    xcursor-theme "Adwaita"
    xcursor-size 32
    hide-when-typing
}

// === 出力 (phoenix の 4K 2 枚) ===
// niri は output 設定が無いと物理サイズから小数スケールを自動で決める (この 2 枚では
// 1.5 と 1.25 になっていた)。等倍で使いたいので明示する。DMS の display 設定は
// dms/outputs.kdl に書くが、あれは gitignore された実行時ファイルなのでここで持つ。
// 名前は `niri msg outputs` の見出し。他ホストでは一致せず無視されるだけ。
// 位置は書かない (niri の自動配置に任せる)。
output "Dell Inc. DELL U2718QM KWHF293E0JRL" {
    scale 1
}
output "LG Electronics LG ULTRAFINE 501NTGY30383" {
    scale 1
}

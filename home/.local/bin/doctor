#!/usr/bin/env bash

# rebuild では解決しない手作業 (ログイン、鍵、認証) がどれだけ残っているかを
# 一覧する。rebuild は宣言できるものだけを揃えて終わるので、新しいマシンでは
# 「あと何をすれば普段どおりになるか」が見えない。それをここで機械的に判定する。
#
# 各項目は「今その状態か」を確かめる check と、足りないときに打つコマンドの
# 対で書く。直すのは人 (ログインは対話が要る) で、このスクリプトは状態を変えない。
# 冪等で、揃っていれば ok だけが並ぶ。
#
# CLI から判定できないもの (GUI アプリのログイン) は扱わない。判定できない項目を
# 並べても済んだかどうかが分からず、毎回同じ行が出るだけになる。
#
# 使い方: doctor
#   終了コード: 全部 ok なら 0、足りないものがあれば 1

set -u

# 対応確認の応答を読むと診断コマンドの stdin と競合するので、任意の probe はしない。
# ログには制御列を残さず、NO_COLOR は文字色だけに適用する。
program_status() {
  [[ -t 2 ]] || return 0
  local title msg
  title=$(printf '%s' "$3" | base64 | tr -d '\r\n')
  msg=$(printf '%s' "$4" | base64 | tr -d '\r\n')
  printf '\033]7501;state=%s:id=%s:app=doctor:title=%s:msg=%s%s\033\\' \
    "$1" "$2" "$title" "$msg" "${5:+:progress=$5}" >&2
}
doctor_exit() {
  local code=$?
  if [[ $code == 130 || $code == 143 ]]; then
    if [[ -n $active_id ]]; then
      program_status clear "$active_id" '' ''
    fi
    program_status idle doctor 'Environment diagnosis' 'Diagnosis cancelled'
  elif [[ $diagnosis_complete == 1 ]]; then
    # missing は診断の正常な結果で、人の入力を待っているわけでもない。
    program_status 'done' doctor 'Environment diagnosis' \
      "Checks complete: $passed passed, $failed missing"
  else
    program_status error doctor 'Environment diagnosis' 'Diagnosis failed'
  fi
  return "$code"
}
diagnosis_complete=0
active_id=''
passed=0 failed=0 completed=0
trap doctor_exit EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
program_status clear doctor '' ''
program_status working doctor 'Environment diagnosis' 'Preparing checks' 0

# 出力は install と同じ cargo 風。tty のときだけ色を付ける。
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  c_ok=$'\033[1;32m' c_ng=$'\033[1;31m' c_dim=$'\033[2m' c_reset=$'\033[0m'
else
  c_ok='' c_ng='' c_dim='' c_reset=''
fi

os=$(uname -s)
host=${HOSTNAME:-$(hostname)}
host=${host%.local}
missing=0

# check <name> <fix> <cmd...>
#   cmd が 0 で終われば ok、それ以外なら fix を添えて出す。cmd の出力は捨てる
#   (状態表示だけが目的で、診断の詳細は fix のコマンドを打てば見える)。
# OS・ホストで対象数が変わるので、先に登録してから実行し、件数を進捗に使う。
checks=()
check() {
  local command
  printf -v command '%q ' "$@"
  checks+=("$command")
}
run_check() {
  local name=$1 fix=$2
  shift 2
  active_id="doctor/check-$((completed + 1))"
  program_status working doctor 'Environment diagnosis' "Checking $name" "$((completed * 100 / ${#checks[@]}))"
  program_status working "$active_id" "$name" "Checking $name"
  if "$@" >/dev/null 2>&1; then
    printf '%s%12s%s %s\n' "$c_ok" ok "$c_reset" "$name"
    passed=$((passed + 1))
    program_status 'done' "$active_id" "$name" 'Check passed'
  else
    printf '%s%12s%s %s  %s→ %s%s\n' "$c_ng" missing "$c_reset" "$name" "$c_dim" "$fix" "$c_reset"
    missing=1
    failed=$((failed + 1))
    program_status error "$active_id" "$name" "Missing; run: $fix"
  fi
  active_id=''
  completed=$((completed + 1))
  program_status working doctor 'Environment diagnosis' \
    "Checked $completed of ${#checks[@]} items" "$((completed * 100 / ${#checks[@]}))"
}

# --- 土台 (他の項目がこれに依存する) ---

if [[ $os == Linux ]]; then
  # パスワードは宣言していない (common.nix)。無いと GDM でログインできない。
  # ハッシュが ! や * ならロック状態。sudo は wheel なので聞かれない。
  passwd_set() { sudo -n grep -q '^potsbo:[^!*:]' /etc/shadow; }
  check "user password" "sudo passwd potsbo" passwd_set
fi

# 他ホストの sshd は GitHub の公開鍵を毎回引くので、登録するまで他ホストにも入れない。
if [[ $os == Darwin ]]; then
  ssh_public_key="$HOME/.ssh/id_secure_enclave.pub"
  check "Secure Enclave SSH reference" "ssh-secure-enclave-setup" test -s "$HOME/.ssh/id_secure_enclave"
  check "ssh public key" "ssh-secure-enclave-setup" test -s "$ssh_public_key"
else
  ssh_public_key="$HOME/.ssh/id_ed25519.pub"
  check "ssh key" "ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519" test -f "$ssh_public_key"
fi
ssh_key_on_github() {
  local key
  key=$(cut -d' ' -f2 "$ssh_public_key") || return 1
  curl -fsSL --max-time 10 https://github.com/potsbo.keys | grep -qF "$key"
}
check "ssh key on GitHub" "gh ssh-key add ${ssh_public_key/#$HOME/\~}" ssh_key_on_github

# gh は git の credential helper、nix の GitHub token、notes-pull が依存する。
# ログイン後に rebuild をもう一度流すと access-tokens.conf が生える (dotfiles.nix)。
check "gh" "gh auth login && rebuild" gh auth status
check "nix github token" "rebuild (after gh login)" test -f ~/.config/nix/access-tokens.conf

# --- ログイン ---

# `claude auth status` は JSON を返す。loggedIn だけ見る。
claude_logged_in() { claude auth status 2>/dev/null | grep -q '"loggedIn": *true'; }
check "claude" "claude auth login" claude_logged_in

# codex / copilot は status コマンドが無いので資格情報ファイルの有無だけ。期限切れは分からない。
check "codex" "codex login" test -f ~/.codex/auth.json
check "copilot" "copilot login" test -f ~/.config/github-copilot/auth.db

gcloud_active() { [[ -n $(gcloud auth list --filter=status:ACTIVE --format='value(account)' 2>/dev/null) ]]; }
check "gcloud" "gcloud auth login" gcloud_active
check "gcloud ADC" "gcloud auth application-default login" test -f ~/.config/gcloud/application_default_credentials.json

# login_session を持つ profile は本人アカウントの 1 つだけ (aws/config)。他はそれを source にする。
# profile 名がメアドなので直書きせず config から引く (公開リポジトリに載せない)。
aws_profile=$(awk -v cfg="${AWS_CONFIG_FILE:-$HOME/.config/aws/config}" '
  BEGIN { while ((getline line < cfg) > 0) {
    if (line ~ /^\[profile /) { sub(/^\[profile /, "", line); sub(/\]$/, "", line); p = line }
    else if (line ~ /^login_session/) { print p; exit }
  } }')
check "aws" "aws login --profile $aws_profile" aws sts get-caller-identity --profile "$aws_profile"

# .zshrc の xfreerdp ラッパーが `op read` する。
check "op" "op signin" op whoami

# macOS は CLI が app bundle の中にあり PATH に無い。
tailscale_bin() {
  if command -v tailscale >/dev/null; then echo tailscale
  elif [[ -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ]]; then echo /Applications/Tailscale.app/Contents/MacOS/Tailscale
  else return 1
  fi
}
tailscale_running() {
  local bin
  bin=$(tailscale_bin) || return 1
  "$bin" status --json 2>/dev/null | grep -q '"BackendState": *"Running"'
}
if [[ $os == Darwin ]]; then
  check "tailscale" "open -a Tailscale (then sign in)" tailscale_running
else
  check "tailscale" "sudo tailscale up" tailscale_running
fi

# --- リポジトリ・toolchain ---

# notes-pull は dir が無いと exit 0 で黙って何もしない。
check "notes repo" "ghq get potsbo/notes" test -d ~/src/github.com/potsbo/notes/.git

# dotfiles.nix が hunk skill path を張る。hunk が aqua で未導入だと no-op で終わる。
check "hunk review skill" "hunk --version && rebuild" test -L ~/.claude/skills/hunk-review

# lazy.nvim は初回起動で取りに行く。cache コマンドが前倒しする。
nvim_plugins() { [[ -n $(ls -A ~/.local/share/nvim/lazy 2>/dev/null) ]]; }
check "nvim plugins" "cache (or start nvim once)" nvim_plugins

# rustup を使っているマシンだけ。cargo/rustc は nix で入るので無くてもよい。
if command -v rustup >/dev/null; then
  check "rust toolchain" "rustup default stable" rustup show active-toolchain
fi

# --- ホスト固有 ---

if [[ $host == raptorlake ]]; then
  # 宣言に入れられない資格情報。手順は hosts/raptorlake/README.md。
  check "cloudflared token" "hosts/raptorlake/README.md (SSH via Cloudflare)" sudo -n test -s /srv/cloudflared/env
  check "smb credentials" "hosts/raptorlake/README.md (Google shared drives)" sudo -n test -s /etc/smb-credentials/gdrive
fi

# --- macOS ---

if [[ $os == Darwin ]]; then
  check "xcode CLT" "xcode-select --install" xcode-select -p
  # 公式 installer の nix.conf が残っていると nix-darwin の初回 switch が止まる (darwin/default.nix)。
  check "nix.conf (nix-darwin)" "sudo mv /etc/nix/nix.conf /etc/nix/nix.conf.before-nix-darwin && rebuild" test -L /etc/nix/nix.conf
  # uid が宣言と違うと nix-darwin は警告だけ出して UserShell を書かない (darwin/default.nix)。
  login_shell_is_nix() { dscl . -read "/Users/$USER" UserShell | grep -q ' /run/current-system/sw/bin/zsh$'; }
  check "login shell (nix zsh)" "match uid in modules/darwin/default.nix to id -u, then rebuild" login_shell_is_nix
  # GUI アプリは rebuild から切り離してある。brew と mas は apps が使う。
  check "homebrew" "apps" command -v brew
  check "app store" "sign in to App Store" mas account
fi

for registered_check in "${checks[@]}"; do
  eval "run_check $registered_check"
done

diagnosis_complete=1
exit "$missing"

#!/usr/bin/env bash
# scp のサブセットとして振る舞い、受信側がすでに持っているバイト列は送らない。
# Usage: cascp [-r] host:path local
#
# 送信側で desync が chunk に切って store に入れ、受信側は足りない chunk だけ取ってきて
# 組み立てる。store は全マシン共通で ${XDG_CACHE_HOME:-~/.cache}/desync に置き、
# 送信側では store、受信側では cache として同じものを使う。中身は chunk のハッシュが
# 名前なので不変で、消しても次回に再転送が増えるだけ。送信側に要るのは desync と rsync。

# remote() に渡す script はリモートの shell で展開させるので、single quote が意図どおり
# shellcheck disable=SC2016
set -euo pipefail

# 出力は rebuild と同じ cargo 風 (右揃えの動詞 + 対象)。
if [[ -t 2 && -z "${NO_COLOR:-}" ]]; then
  c_verb=$'\033[1;32m' c_err=$'\033[1;31m' c_reset=$'\033[0m'
else
  c_verb='' c_err='' c_reset=''
fi
step() { printf '%s%12s%s %s\n' "$c_verb" "$1" "$c_reset" "${*:2}" >&2; }
die() {
  printf '%s%12s%s %s\n' "$c_err" error "$c_reset" "$*" >&2
  exit 1
}
usage() {
  echo "Usage: cascp [-r] host:path local" >&2
  exit 1
}
human() {
  awk -v b="$1" 'BEGIN {
    split("B KiB MiB GiB TiB", u, " "); i = 1
    while (b >= 1024 && i < 5) { b /= 1024; i++ }
    printf(i == 1 ? "%d %s" : "%.1f %s", b, u[i])
  }'
}
duration() { printf '%dm%02ds' $(($1 / 60)) $(($1 % 60)); }

recursive=false
while getopts r opt; do
  case $opt in
    r) recursive=true ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))
[ $# -eq 2 ] || usage
[[ $1 == *:* ]] || die "source must be host:path (pull only)"
host=${1%%:*}
rpath=${1#*:}
# scp と同じく相対パスはリモートの home から解決されるので、~/ は外すだけでよい
rpath=${rpath#\~/}
rpath=${rpath:-.}
dst=$2

cache="${XDG_CACHE_HOME:-$HOME/.cache}/desync"
mkdir -p "$cache"
bars=
[ -t 2 ] && bars=1

tmp=$(mktemp -d)
sock="$tmp/ssh"
trap 'ssh -S "$sock" -O exit "$host" 2>/dev/null || true; rm -rf "$tmp"' EXIT
# desync extract は SIGINT/SIGTERM を受けると、書きかけの出力を本来の名前に置いて 0 で
# 終わる (v1.1.4)。成功に見えないよう、こちらで非 0 にする。
trap 'exit 130' INT TERM

step Connecting "$host"
# 往復 300ms 級の回線を想定しているので、ssh の確立は 1 回にして使い回す
ssh -fNM -S "$sock" "$host"
# script は引数で渡す。stdin は chunk の一覧を流すのに空けておく。
remote() {
  local script=$1
  shift
  ssh -S "$sock" "$host" "sh -c $(printf %q "$script") cascp $(printf '%q ' "$@")"
}

info=$(remote '
if [ -d "$1" ]; then
  kind=dir size=$(($(du -sk "$1" | cut -f1) * 1024)) n=$(find "$1" -type f | wc -l)
elif [ -f "$1" ]; then
  kind=file size=$(wc -c <"$1") n=1
else
  echo "cascp: $1: No such file or directory" >&2
  exit 1
fi
mode=$(stat -c %a "$1" 2>/dev/null || stat -f %Lp "$1")
echo $kind $mode $size $n "${XDG_CACHE_HOME:-$HOME/.cache}/desync"
' "$rpath")
read -r kind mode size nfiles rstore <<<"$info"
[ "$kind" = file ] || $recursive || die "$rpath: not a regular file"

desc="$(human "$size")"
[ "$kind" = dir ] && desc="$desc, $nfiles files"
step Chunking "$host:$rpath ($desc)"
idx="$tmp/index"
t0=$SECONDS
remote '
store=${XDG_CACHE_HOME:-$HOME/.cache}/desync
mkdir -p "$store"
[ -n "$3" ] && export DESYNC_PROGRESSBAR_ENABLED=1
case $1 in
  dir) exec desync tar -i -s "$store" - "$2" ;;
  file) exec desync make -s "$store" - "$2" ;;
esac
' "$kind" "$rpath" "$bars" >"$idx"
t_chunk=$((SECONDS - t0))

desync list-chunks "$idx" | sort -u | while read -r id; do
  f="${id:0:4}/$id.cacnk"
  if [ -e "$cache/$f" ]; then echo "0 $f"; else echo "1 $f"; fi
done >"$tmp/chunks"
grep '^1 ' "$tmp/chunks" | cut -c3- >"$tmp/missing" || true
# 回線を流れるのは圧縮後の chunk なので、残り時間はその合計から出す
remote '
cd "$1" || exit 1
if stat -c %s . >/dev/null 2>&1; then set -- -c %s; else set -- -f %z; fi
tr "\n" "\0" | xargs -0 stat "$@"
' "$rstore" < <(cut -c3- "$tmp/chunks") >"$tmp/sizes"
read -r n_all n_fetch c_all c_fetch < <(paste -d' ' "$tmp/chunks" "$tmp/sizes" | awk '
  { n++; t += $3; if ($1) { k++; m += $3 } }
  END { printf "%d %d %d %d\n", n, k, t, m }')
step Chunks "$n_all unique, $(human "$c_all") compressed (chunked in $(duration "$t_chunk"))"
step Cached "$((n_all - n_fetch)) chunks, $(human $((c_all - c_fetch))) ($(((n_all - n_fetch) * 100 / (n_all ? n_all : 1)))%)"

# rsync の progress2 は全体の % は出すが、chunk が小さいので時刻欄は経過時間になり
# 残り時間が出ない。送る量は上で分かっているので、平均速度から自前で出す。
show_progress() {
  local total=$1 start=$SECONDS last=-1 line bytes rate el eta
  while IFS= read -r -d $'\r' line || [ -n "$line" ]; do
    read -r bytes _ rate _ <<<"$line"
    [[ $bytes =~ ^[0-9]+$ ]] || continue
    el=$((SECONDS - start))
    # awk を毎行起こすと chunk 数万個で重いので、表示は 1 秒に 1 回
    ((el != last)) || continue
    last=$el
    eta=--
    ((bytes > 0)) && eta=$(duration $((el * (total - bytes) / bytes)))
    printf '\r\033[K%12s %s / %s (%d%%)  %s  elapsed %s  ETA %s' "" \
      "$(human "$bytes")" "$(human "$total")" $((bytes * 100 / (total ? total : 1))) \
      "$rate" "$(duration "$el")" "$eta" >&2
  done
  printf '\r\033[K' >&2
}

t0=$SECONDS
if [ "$n_fetch" -gt 0 ]; then
  step Fetching "$n_fetch chunks, $(human "$c_fetch") from $host"
  # desync 自身の ssh:// store は 1 セッションで chunk を 1 個ずつ往復して取るので、
  # 往復 300ms だと帯域に関係なく 10 並列でも 2MB/s 程度で頭打ちになる。
  # 足りない chunk を先に列挙して rsync でまとめて流せば、往復は 1 回で帯域律速になる。
  # rsync は一時ファイル経由で置くので、中断しても書きかけの chunk は残らない。
  rsync --files-from="$tmp/missing" --info=progress2 --no-h --outbuf=N -e "ssh -S $sock" \
    "$host:$rstore/" "$cache/" | show_progress "$c_fetch"
fi
t_fetch=$((SECONDS - t0))

[ -d "$dst" ] && dst="${dst%/}/$(basename "$rpath")"
step Assembling "$dst"
case $kind in
  dir) desync untar -i -s "$cache" --no-same-owner --no-same-xattrs "$idx" "$dst" ;;
  file)
    desync extract -s "$cache" "$idx" "$dst"
    chmod "$mode" "$dst"
    ;;
esac

step Finished "fetched $(human "$c_fetch") of $(human "$c_all") in $(duration "$t_fetch"), total $(duration "$SECONDS")"

#!/usr/bin/env bash
# scp のサブセットとして振る舞い、受信側がすでに持っているバイト列は送らない。
# Usage: cascp [-r] host:path local
#
# 送信側で desync が chunk に切って store に入れ、受信側は足りない chunk だけ取ってきて
# 組み立てる。store は全マシン共通で ${XDG_CACHE_HOME:-~/.cache}/desync に置き、
# 送信側では store、受信側では cache として同じものを使う。中身は chunk のハッシュが
# 名前なので不変で、消しても次回に再転送が増えるだけ。送信側に要るのは desync と rsync。
set -euo pipefail

usage() {
  echo "Usage: cascp [-r] host:path local" >&2
  exit 1
}
die() {
  echo "cascp: $*" >&2
  exit 1
}

recursive=false
while getopts r opt; do
  case $opt in
    r) recursive=true ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))
[ $# -eq 2 ] || usage
[[ $1 == *:* ]] || die "source must be host:path (pull only)"
host=${1%%:*}
rpath=${1#*:}
# scp と同じく相対パスはリモートの home から解決されるので、~/ は外すだけでよい
rpath=${rpath#\~/}
rpath=${rpath:-.}
dst=$2

cache="${XDG_CACHE_HOME:-$HOME/.cache}/desync"
mkdir -p "$cache"

tmp=$(mktemp -d)
sock="$tmp/ssh"
trap 'ssh -S "$sock" -O exit "$host" 2>/dev/null || true; rm -rf "$tmp"' EXIT
# desync extract は SIGINT/SIGTERM を受けると、書きかけの出力を本来の名前に置いて 0 で
# 終わる (v1.1.4)。成功に見えないよう、こちらで非 0 にする。
trap 'exit 130' INT TERM

# 往復 300ms 級の回線を想定しているので、ssh の確立は 1 回にして使い回す
ssh -fNM -S "$sock" "$host"
remote() { ssh -S "$sock" "$host" "sh -s -- $(printf '%q ' "$@")"; }

info=$(remote "$rpath" <<'EOF'
if [ -d "$1" ]; then kind=dir
elif [ -f "$1" ]; then kind=file
else echo "cascp: $1: No such file or directory" >&2; exit 1
fi
mode=$(stat -c %a "$1" 2>/dev/null || stat -f %Lp "$1")
echo "$kind $mode ${XDG_CACHE_HOME:-$HOME/.cache}/desync"
EOF
)
read -r kind mode rstore <<<"$info"
[ "$kind" = file ] || $recursive || die "$rpath: not a regular file"

idx="$tmp/index"
remote "$kind" "$rpath" >"$idx" <<'EOF'
store=${XDG_CACHE_HOME:-$HOME/.cache}/desync
mkdir -p "$store"
case $1 in
  dir) exec desync tar -i -s "$store" - "$2" ;;
  file) exec desync make -s "$store" - "$2" ;;
esac
EOF

# desync 自身の ssh:// store は 1 セッションで chunk を 1 個ずつ往復して取るので、
# 往復 300ms だと帯域に関係なく 10 並列でも 2MB/s 程度で頭打ちになる。
# 足りない chunk を先に列挙して rsync でまとめて流せば、往復は 1 回で帯域律速になる。
# rsync は一時ファイル経由で置くので、中断しても書きかけの chunk は残らない。
desync list-chunks "$idx" | sort -u | while read -r id; do
  f="${id:0:4}/$id.cacnk"
  [ -e "$cache/$f" ] || echo "$f"
done >"$tmp/missing"
if [ -s "$tmp/missing" ]; then
  rsync --files-from="$tmp/missing" --info=progress2 -e "ssh -S $sock" "$host:$rstore/" "$cache/"
fi

[ -d "$dst" ] && dst="$dst/$(basename "$rpath")"
case $kind in
  dir) desync untar -i -s "$cache" --no-same-owner --no-same-xattrs "$idx" "$dst" ;;
  file)
    desync extract -s "$cache" "$idx" "$dst"
    chmod "$mode" "$dst"
    ;;
esac

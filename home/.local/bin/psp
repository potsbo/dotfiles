#!/usr/bin/env bash

# Usage: psp command [args...]
# パイプラインは psp sh -c 'command | command' で明示的にまとめる。
# 自動フックでは TUI の操作中も working になるため、指定した処理だけを追う。

if (( $# == 0 )); then
  printf 'Usage: psp command [args...]\n' >&2
  exit 2
fi

# ログに制御列を混ぜない。probe は子コマンドの stdin と競合するので送らない。
if [[ ! -t 2 ]]; then
  exec "$@"
fi

# 引数には秘密情報が入りうるため、表示するのは実行ファイル名だけ。
# 制御文字と長すぎる名前で OSC 全体が拒否されないよう、ASCII の短い表示名にする。
command_label=$(printf '%s' "${1##*/}" | LC_ALL=C tr -cd '[:print:]' | head -c 192 | base64 | tr -d '\r\n')
# 専用 id にして、子コマンド自身の詳細な状態を上書きしない。
program_status() {
  printf '\033]7501;state=%s:id=psp:app=psp:title=%s:msg=%s\033\\' \
    "$1" "$command_label" "$command_label" >&2
}
psp_exit() {
  local code=$?
  if (( code == 130 || code == 143 )); then
    program_status clear
  elif (( code == 0 )); then
    program_status done
  else
    program_status error
  fi
  return "$code"
}
trap psp_exit EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

program_status working
"$@"

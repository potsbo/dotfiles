#!/usr/bin/env bash

# 「いつかどうせやる」初回セットアップを先に全部やっておく。
# ./install は速さを優先して遅延インストールのまま終えるので、時間があるときに
# これを流して初回コストを前倒しする。reap の裏返し (reap は再生成できるものを
# 捨てる / cache は再生成できるものを先に作る)。
#
# 対象:
#   - aqua : 全パッケージのバイナリ取得 (install は --only-link で実体を落とさない)
#   - aqua : local registry の policy 許可 (macmon / ghui / ax に必要な一度きりの作業)
#   - nvim : lazy.nvim の plugin、mason のサーバー/ツール、treesitter の parser
#   - tldr : ページキャッシュ
#   - zsh  : compinit の zcompdump と evalcache (direnv / fzf / starship)
#   - repo : git リポジトリ内で実行した場合のみ、そのリポジトリの依存取得
#            (JS lockfile / uv.lock / go.mod / Cargo.toml / aqua.yaml)
#
# 全て冪等。既に揃っていれば数秒で終わる。
#
# 使い方: cache [--dry-run]
#   --dry-run : 実行せず、何を流すかだけ表示

set -eu

DRY_RUN=0
[ "${1:-}" = "--dry-run" ] && { DRY_RUN=1; shift; }

run() {
  echo "+ $*"
  [ "$DRY_RUN" = 1 ] && return 0
  "$@"
}

# --- aqua: 遅延インストールされる実体を先に取得 ---
if command -v aqua >/dev/null 2>&1; then
  echo "== aqua =="
  # local registry を使うパッケージは policy を許可しないと install が失敗する
  if [ -n "${AQUA_POLICY_CONFIG:-}" ]; then
    run aqua policy allow "$AQUA_POLICY_CONFIG"
  fi
  run aqua install --all
fi

# --- nvim: plugin / mason / treesitter ---
# lazy.nvim は install と restore が別コマンド。restore は導入済みのものを lockfile の
# rev に戻すだけで、未導入の plugin は入れないので install を先に流す必要がある。
if command -v nvim >/dev/null 2>&1; then
  echo "== nvim =="
  nvim_cache="${XDG_CONFIG_HOME:-$HOME/.config}/nvim/scripts/cache.lua"
  run nvim --headless "+Lazy! install" +qa
  run nvim --headless "+Lazy! restore" +qa
  if [ -f "$nvim_cache" ]; then
    run nvim --headless -c "luafile $nvim_cache"
  fi
fi

# --- tldr: ページキャッシュ ---
if command -v tldr >/dev/null 2>&1; then
  echo "== tldr =="
  run tldr --update
fi

# --- zsh: 対話シェルの初回起動で作られるキャッシュ ---
# compinit の zcompdump と evalcache の生成が目的なので、起動させるだけでよい。
if command -v zsh >/dev/null 2>&1; then
  echo "== zsh =="
  run zsh -ic exit
fi

# --- repo: git リポジトリ内で実行した場合、そのリポジトリの依存も取得 ---
# どのツールで入れるかは推測せず、リポジトリ側の宣言から決定的に判定できるもの
# だけ実行する。判定できなければ理由を出してスキップ。マーカーは repo root で見る
# (monorepo でも lockfile は root に置かれるのが普通)。
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -n "$repo_root" ]; then
  echo "== repo ($repo_root) =="
  cd "$repo_root"

  # remote の object を先に取得しておく (remote 未設定の repo では何もしない)。
  # shallow clone は全履歴を取って解消する (--unshallow は完全な repo だと fatal)
  if [ -n "$(git remote)" ]; then
    if [ "$(git rev-parse --is-shallow-repository)" = true ]; then
      run git fetch --unshallow
    else
      run git fetch
    fi
  fi
  [ -f .gitmodules ] && run git submodule update --init --recursive

  # JS: package.json の packageManager フィールド (corepack 標準) が最優先、
  # なければ lockfile の種類で判定。lockfile が複数あるときは判定不能。
  if [ -f package.json ]; then
    js_pm="$(jq -r '.packageManager // empty' package.json 2>/dev/null | cut -d@ -f1 || true)"
    if [ -z "$js_pm" ]; then
      found=""
      [ -f pnpm-lock.yaml ] && found="$found pnpm"
      [ -f yarn.lock ] && found="$found yarn"
      [ -f package-lock.json ] && found="$found npm"
      { [ -f bun.lock ] || [ -f bun.lockb ]; } && found="$found bun"
      set -- $found
      if [ $# -eq 1 ]; then
        js_pm="$1"
      elif [ $# -eq 0 ]; then
        echo "skip js: lockfile がないので使うツールを判定できない"
      else
        echo "skip js: lockfile が複数あるので使うツールを判定できない ($found)"
      fi
    fi
    if [ -n "$js_pm" ]; then
      if command -v "$js_pm" >/dev/null 2>&1; then
        case "$js_pm" in
          npm) run npm ci ;;
          *) run "$js_pm" install --frozen-lockfile ;;
        esac
      else
        echo "skip js: $js_pm が未導入"
      fi
    fi
  fi

  [ -f uv.lock ] && command -v uv >/dev/null 2>&1 && run uv sync --frozen
  [ -f go.mod ] && command -v go >/dev/null 2>&1 && run go mod download
  [ -f Cargo.toml ] && command -v cargo >/dev/null 2>&1 && run cargo fetch
  # repo local の aqua.yaml (global の分は上の aqua セクションで取得済み)
  { [ -f aqua.yaml ] || [ -f aqua.yml ]; } && command -v aqua >/dev/null 2>&1 && run aqua install
fi

if [ "$DRY_RUN" = 1 ]; then
  echo "dry-run: 上記を実行すると初回セットアップを前倒しします。"
else
  echo "done"
fi

#!/usr/bin/env bash
# raptorlake-win (Windows 11 ゲスト) に設定を当てる。
#   ./hosts/raptorlake-win/apply
#
# bootstrap.ps1 (SYSTEM で当てる sshd の設定) と setup.ps1 (ユーザーとして当てる残り) を
# 毎回この順に流す。bootstrap は libvirt ホスト (raptorlake) の上なら guest agent 経由で、
# それ以外の場所からは ssh 経由で流す。ssh がまだ無い状態を起こせるのは guest agent
# だけなので、作り直した直後の 1 回目は raptorlake の上で実行すること。
#
# スクリプトはゲストに置きっぱなしにしない。ゲスト側に「どの版が置いてあるか」という
# 状態を持たせないため、ssh 越しの分は scp で送って実行し、そのまま消す。
#
# -EncodedCommand に丸ごと載せる形は捨てた。Windows のコマンドライン長 32767 が上限で、
# UTF-16LE の base64 は元の 8/3 倍に膨らむため 12KB 程度のスクリプトで超え、2026-09-16 に
# 実際に超えて "exec request failed on channel 0" で落ちた。本体を stdin から渡してスタブで
# 実行する形も試したが、数 KB を超えると ssh の既定シェル (powershell) を挟んだ先で
# 読み手が止まる。素の -Command - は、1 行ずつ実行するので複数行の構文が壊れる。
# guest agent 経由 (bootstrap) は同じ長さの制限を持つが、あちらは小さいままなので触らない。

set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
guest=raptorlake-win
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

ssh_ok() { ssh -o BatchMode=yes -o ConnectTimeout=5 "$guest" exit >/dev/null 2>&1; }

# PowerShell の -EncodedCommand は UTF-16LE の base64
encode() { iconv -f utf-8 -t utf-16le "$1" | base64 -w0; }


# ssh 越しの実行。送って、流して、消す。
# BOM を付けるのは、PowerShell 5.1 の -File が BOM の無いファイルをコードページ (cp932)
# として読むから。UTF-8 のまま渡すと日本語のコメントごと壊れる。
ssh_powershell() {
  local remote payload
  remote="apply-$$.ps1"
  payload=$(mktemp)
  printf '\xef\xbb\xbf' > "$payload"
  cat "$1" >> "$payload"
  scp -q "$payload" "$guest:$remote"
  rm -f "$payload"
  ssh "$guest" "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File $remote; \$c = \$LASTEXITCODE; Remove-Item -Force -ErrorAction SilentlyContinue $remote; exit \$c"
}
# guest-exec は非同期で pid を返す。終了を待って出力を取り出す。JSON の組み立てと分解は jq。
guest_powershell() {
  local enc req pid status
  enc=$(encode "$1")
  req=$(jq -cn --arg enc "$enc" '{execute:"guest-exec",arguments:{path:"powershell.exe",arg:["-NoProfile","-NonInteractive","-EncodedCommand",$enc],"capture-output":true}}')
  pid=$(virsh -c qemu:///system qemu-agent-command "$guest" "$req" | jq '.return.pid')
  while :; do
    status=$(virsh -c qemu:///system qemu-agent-command "$guest" "{\"execute\":\"guest-exec-status\",\"arguments\":{\"pid\":$pid}}")
    if [ "$(jq '.return.exited' <<<"$status")" = true ]; then
      jq -r '.return["out-data"] // empty' <<<"$status" | base64 -d
      jq -r '.return["err-data"] // empty' <<<"$status" | base64 -d >&2
      return "$(jq '.return.exitcode' <<<"$status")"
    fi
    sleep 2
  done
}

if [ "$(hostname)" = raptorlake ]; then
  guest_powershell "$here/bootstrap.ps1"
  # ホスト鍵は bootstrap でゲストが作る。初回接続で受け入れる (TOFU) のではなく、
  # 既に信頼している経路 (guest agent) で公開鍵を取り出して known_hosts に固定する。
  echo 'Get-Content C:\ProgramData\ssh\ssh_host_ed25519_key.pub' > "$tmp"
  hostkey=$(guest_powershell "$tmp" | awk '{print $1, $2}')
  if ! ssh-keygen -F "$guest" -f ~/.ssh/known_hosts 2>/dev/null | grep -q "$hostkey"; then
    ssh-keygen -R "$guest" >/dev/null 2>&1 || true
    printf '%s %s\n' "$guest" "$hostkey" >> ~/.ssh/known_hosts
  fi
else
  ssh_ok || { echo "ssh が通らない。作り直した直後は raptorlake の上で実行すること" >&2; exit 1; }
  # sshd の設定が変わると bootstrap 自身が sshd を再起動し、この接続ごと切れる。
  # そのときは終了コードが 255 になるだけなので、通らなくなっていないかを後で確かめる。
  ssh_powershell "$here/bootstrap.ps1" || true
fi
# sshd の起動を待つ
for _ in $(seq 1 15); do ssh_ok && break; sleep 2; done
ssh_ok || { echo "bootstrap 後に ssh が通らない" >&2; exit 1; }

ssh "$guest" "powershell -NoProfile -NonInteractive -EncodedCommand $(encode "$here/setup.ps1")"

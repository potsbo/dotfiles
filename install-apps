#!/usr/bin/env bash

# macOS の GUI アプリ (Homebrew cask / Mac App Store) を入れ直す。
# brew / mas は遅く、Word などの更新が挟まると数分待たされるため
# ./install からは切り離してある。アプリを足した / 消したときだけ実行する。

set -eu

has() {
  return $(type $1 >/dev/null 2>&1)
}

SYSTEM=$(uname -s)
HOSTNAME="${HOSTNAME:-$(hostname)}"
HOSTNAME="${HOSTNAME%.local}"
DOTPATH="${HOME}/src/github.com/potsbo/dotfiles"

if [[ "$SYSTEM" != "Darwin" ]]; then
  echo "install-apps is macOS only"
  exit 1
fi

case "$HOSTNAME" in
avalanche | blizzard)
  CONFIG="$HOSTNAME"
  ;;
*)
  echo "Unknown hostname: $HOSTNAME"
  exit 1
  ;;
esac

# nix-darwin の homebrew module が使う brew 本体
if ! has "brew"; then
  echo "Installing Homebrew..."
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

echo "nix-darwin: Using configuration: ${CONFIG}-apps"
sudo -H nix --extra-experimental-features 'nix-command flakes' run "${DOTPATH}/nix" -- switch --flake "${DOTPATH}/nix#${CONFIG}-apps" --verbose

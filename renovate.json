{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>aquaproj/aqua-renovate-config#2.15.0"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["\\.nix$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\n]+)\\n\\s*version\\s*=\\s*\"(?<currentValue>[^\"]+)\";"
      ],
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["^pkgs/.*\\.nix$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>git-refs) depName=(?<depName>\\S+) branch=(?<currentValue>\\S+)\\n\\s*rev\\s*=\\s*\"(?<currentDigest>[0-9a-f]{40})\";"
      ]
    },
    {
      "customType": "regex",
      "fileMatch": ["^flake\\.nix$"],
      "matchStrings": [
        "url\\s*=\\s*\"github:(?<depName>[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)/(?<currentValue>v?[0-9]+\\.[0-9]+\\.[0-9]+[^\"/?\\s]*)\""
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "fileMatch": ["home/.config/aquaproj-aqua/aqua\\.yaml$"],
      "matchStrings": [
        "name:\\s*(?<depName>[^@\\s]+)@(?<currentValue>v?[0-9][^\\s]*)\\s*\\n\\s*registry:\\s*local"
      ],
      "datasourceTemplate": "github-releases"
    }
  ],
  "gitIgnoredAuthors": [
    "114827586+autofix-ci[bot]@users.noreply.github.com"
  ],
  "nix": {
    "enabled": true
  },
  "timezone": "Asia/Tokyo",
  "lockFileMaintenance": {
    "description": [
      "毎日 lock を更新して automerge する。依存更新の中で最優先。",
      "prPriority: config:recommended の prHourlyLimit (2) を毎回 aqua 等の更新が使い切り、優先度の低い lock 更新が Rate-Limited のまま 2026-11-09 から止まったため。",
      "schedule を半日に広げるのは、Renovate の実行が数時間おきで、4 時間の窓では空き枠のある実行に当たらない日が出るため。"
    ],
    "enabled": true,
    "prPriority": 10,
    "schedule": ["before 12pm"],
    "automerge": true
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "aquaproj/aqua",
        "aquaproj/aqua-installer"
      ],
      "automerge": true
    },
    {
      "matchFileNames": [
        "home/.config/aquaproj-aqua/aqua.yaml"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "automerge": true
    },
    {
      "matchPackageNames": [
        "aquaproj/aqua-renovate-config"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "custom.regex",
        "nix"
      ],
      "automerge": true
    },
    {
      "description": "DMS はデスクトップ全体に効くので automerge せず手で入れる",
      "matchPackageNames": ["AvengeMedia/DankMaterialShell"],
      "automerge": false
    }
  ]
}

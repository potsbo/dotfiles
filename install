#!/usr/bin/env bash

# ref
# - http://qiita.com/b4b4r07/items/24872cdcbec964ce2178#deploy
# - https://github.com/izumin5210/dotfiles/blob/438d5d82378b684500abfded0e92362a0cd500e0/install

set -eu

has() {
  return $(type $1 >/dev/null 2>&1)
}

usage() {
  cat <<'USAGE'
Usage: ./install [--apps] [--cache] [--all]

  既定では速くて高頻度なものだけを流す (nix / home-manager / symlink)。
  遅くて低頻度なものは opt-in にしてある。

  --apps   GUI アプリ (Homebrew cask / Mac App Store) も揃える (macOS のみ)
           単体で叩きたいときは `apps` コマンド
  --cache  遅延インストールされる実体を先に取得する
           単体で叩きたいときは `cache` コマンド
  --all    上記を全部

  curl 経由で渡す場合: curl -fsSL <url> | bash -s -- --all
USAGE
}

WITH_APPS=0
WITH_CACHE=0
while [ $# -gt 0 ]; do
  case "$1" in
  --apps) WITH_APPS=1 ;;
  --cache) WITH_CACHE=1 ;;
  --all)
    WITH_APPS=1
    WITH_CACHE=1
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    echo "Unknown option: $1" >&2
    usage >&2
    exit 1
    ;;
  esac
  shift
done

SYSTEM=$(uname -s)
HOSTNAME="${HOSTNAME:-$(hostname)}"
HOSTNAME="${HOSTNAME%.local}"
REPO="github.com/potsbo/dotfiles"
DOTPATH="${HOME}/src/${REPO}"

# Step 0 validation
# MANAGE_SYSTEM=1 のときだけ nixos-rebuild でシステム全体の設定を触る。
# 既知ホスト = 自分が管理しているマシンなのでシステムごと管理する。
# 未知ホスト = 管理外のサーバーなので user (home-manager) 設定だけ入れる。
MANAGE_SYSTEM=0
case "$HOSTNAME" in
avalanche | tigerlake | raptorlake | phoenix | staten-nix | blizzard | skylake)
  CONFIG="$HOSTNAME"
  MANAGE_SYSTEM=1
  ;;
*)
  # nix-darwin は config が無いと switch できないため、未知の macOS は従来どおり弾く
  if [[ "$SYSTEM" == "Darwin" ]]; then
    echo "Unknown hostname: $HOSTNAME"
    echo "Hint: HOSTNAME=<hostname> curl ... | bash"
    exit 1
  fi
  # 未知の Linux / NixOS では汎用の home-manager 設定だけ流す（システムには触れない）
  CONFIG="linux"
  ;;
esac

# Step 1 clone
if [ ! -d $DOTPATH ]; then
  echo "$DOTPATH not found. Cloning..."
  mkdir -p "$(dirname ${DOTPATH})"

  if [[ -e /etc/NIXOS ]]; then
    nix-shell -p git --run "git clone --recursive https://${REPO} ${DOTPATH}"
  else
    git clone --recursive https://${REPO} ${DOTPATH}
  fi
fi

cd $DOTPATH

if [ $? -ne 0 ]; then
  exit 1
fi

# nix configuration (potsbo ユーザーのみ)
# nix の設定を potsbo と hard code していることが理由
# 「nix を install できる環境」と「user が potsbo である」は一致することがほとんどのハズ
if [[ "$USER" == "potsbo" ]]; then
  if ! has "nix"; then
    echo "Installing Nix..."
    curl -L https://nixos.org/nix/install | sh -s
    . "$HOME/.nix-profile/etc/profile.d/nix.sh"
  fi

  export NIX_CONFIG="experimental-features = nix-command flakes"

  # nixos-rebuild (NixOS only, 既知ホストのみ)
  # 未知ホスト (MANAGE_SYSTEM=0) では管理外のシステム設定を壊さないようスキップする
  if [[ -e /etc/NIXOS ]] && [[ "$MANAGE_SYSTEM" == "1" ]]; then
    # 素の `sudo nixos-rebuild switch` は通らない ("file 'nixos-config' was not found
    # in the Nix search path")。/etc/nixos には configuration.nix の symlink しか無く
    # NIX_PATH に nixos-config が無いため。必ずこの per-host flake 形式で呼ぶ。
    #
    # hardware-configuration.nix をまだリポジトリに取り込んでいないホストは
    # /etc/nixos を読むため --impure が要る。pure なホストはフラグを外すことで
    # eval cache が効き、no-op の switch が数秒で終わる。
    # 残りを pure 化するには、そのホストの /etc/nixos/hardware-configuration.nix を
    # nixos/hosts/<host>/ に commit する (phoenix と同じ形)。eval cache は pure かつ
    # git tree が clean なときだけ効く。
    IMPURE_FLAG=""
    if grep -q "/etc/nixos" "${DOTPATH}/nixos/hosts/${CONFIG}/flake.nix"; then
      IMPURE_FLAG="--impure"
    fi
    sudo nixos-rebuild switch --flake "${DOTPATH}/nixos/hosts/${CONFIG}#${CONFIG}" $IMPURE_FLAG
  fi

  # home-manager を registry 経由 (nix run home-manager) で呼ばない。
  # unpinned な参照は rev 確定のため GitHub API を叩き、新環境では gh がまだ
  # 入っていないので未認証のまま 403 に当たりうる。flake.lock で固定済みの
  # activationPackage を直接ビルドすれば API 解決そのものが不要になる。
  # 最新 CLI と lock 済み設定のバージョン skew が消える利点もある。
  HM_ACTIVATION=$(nix build --no-link --print-out-paths "${DOTPATH}/nix#homeConfigurations.${CONFIG}.activationPackage")
  "${HM_ACTIVATION}/activate"
fi

if [ "${CODESPACES:-"false"}" = "true" ]; then
  # codespaces で sudo が command not found になったため入れていない
  # もしかしたら codespaces の環境によっては必要かもしれない
  apt update

  # ghq のために workspace 自体もリンクする
  mkdir -p "${HOME}/src/github.com/$(echo $GITHUB_REPOSITORY | cut -d'/' -f1)"
  TARGET_REPO_PATH="${HOME}/src/github.com/${GITHUB_REPOSITORY}"
  if [ ! -e "${TARGET_REPO_PATH}" ]; then
    # 起動時は CODESPACE_VSCODE_FOLDER が使えなかったので手動で構築
    ln -s "/workspaces/$(echo $GITHUB_REPOSITORY | cut -d'/' -f2)" "${TARGET_REPO_PATH}"
  fi

  # 任意の場所から aqua が使えるようにしておく
  ln -s "$HOME/aqua.yaml" /aqua.yaml
fi

# mitamae が ~/aqua.yaml をリンクするが、mitamae 自体が aqua 経由で動くため
# 先に aqua.yaml の場所を環境変数で指定して循環参照を断ち切る
export AQUA_GLOBAL_CONFIG="${DOTPATH}/home/.config/aquaproj-aqua/aqua.yaml"
export AQUA_POLICY_CONFIG="${DOTPATH}/home/.config/aquaproj-aqua/aqua-policy.yaml"

if has "aqua"; then
  aqua install --only-link
  aqua exec mitamae local lib/recipe.rb
fi

# nix に GitHub のトークンを渡す (home/.config/nix/nix.conf が include する)。
# 未認証だと GitHub API が 60 req/hour で、nix flake update が 403 で落ちる。
# gh を使うので新規に PAT を発行しなくてよい。gh 未認証なら黙って飛ばす。
# 書き込み先が ~ ではなく DOTPATH なのは、.config がディレクトリごと
# symlink される (lib/recipe.rb) ため、リンク前に実体を作ると衝突するため。
if has "gh" && GH_TOKEN=$(gh auth token 2>/dev/null); then
  (
    umask 077
    printf 'access-tokens = github.com=%s\n' "$GH_TOKEN" \
      >"${DOTPATH}/home/.config/nix/access-tokens.conf"
  )
  unset GH_TOKEN
fi

# nix-darwin (macOS only)
# GUI アプリ (Homebrew cask / Mac App Store) を含まない構成。アプリは遅いので
# --apps を付けたときだけ、この後で別途揃える。
if [[ "$USER" == "potsbo" && "$SYSTEM" == "Darwin" ]]; then
  echo "nix-darwin: Using configuration: $CONFIG"
  sudo -H nix --extra-experimental-features 'nix-command flakes' run "${DOTPATH}/nix" -- switch --flake "${DOTPATH}/nix#$CONFIG" --verbose
fi

# opt-in の重いステージ。どちらも単体コマンドとして存在するものを呼ぶだけ。
# PATH 経由ではなく実体を叩くのは、リンクが張られる前の新規マシンでも動くため。
# 順序が コア → apps → cache なのは、cache の aqua install が上で貼った
# symlink と AQUA_GLOBAL_CONFIG を前提にするため。
if [[ "$WITH_APPS" == "1" ]]; then
  if [[ "$SYSTEM" == "Darwin" ]]; then
    "${DOTPATH}/home/.local/bin/apps"
  else
    echo "--apps は macOS 専用なのでスキップします"
  fi
fi

if [[ "$WITH_CACHE" == "1" ]]; then
  "${DOTPATH}/home/.local/bin/cache"
fi
